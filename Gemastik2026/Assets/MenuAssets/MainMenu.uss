:root {
}

.button {
    width: 300px;
    align-items: center;
    justify-content: flex-start;
    align-self: center;
    height: 100px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    font-size: 50px;
    transition-property: all;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
}

.button:hover {
    align-items: center;
    justify-content: flex-start;
    align-self: center;
    width: 350px;
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    height: 125px;
    rotate: 2deg;
    background-color: rgb(21, 255, 10);
    font-size: 55px;
}

.header {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 100px;
    align-self: center;
    margin-top: 100px;
    transition-property: font-size;
    transition-timing-function: ease-in;
    transition-duration: 1s;
}



.header-grow {
    font-size: 150px;
    transition-timing-function: ease-out;
}
