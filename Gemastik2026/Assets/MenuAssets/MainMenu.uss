:root {
}

.button {
    width: 300px;
    align-items: center;
    justify-content: flex-start;
    align-self: center;
    height: 75px;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    font-size: 50px;
    transition-property: all;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
    background-image: url("project://database/Assets/UI/UISet.png?fileID=-926489685069194515&guid=491c248f01c09264ab5ca29c0cb129fe&type=3#UISet_10");
    -unity-slice-scale: 0.2px;
}

.button:hover {
    align-items: center;
    justify-content: flex-start;
    align-self: center;
    margin-top: 20px;
    margin-right: 20px;
    margin-bottom: 20px;
    margin-left: 20px;
    rotate: 0 0 0 0;
    font-size: 75px;
}

.header {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 150px;
    align-self: center;
    margin-top: 100px;
    transition-property: font-size;
    transition-timing-function: ease-in;
    transition-duration: 1s;
}
